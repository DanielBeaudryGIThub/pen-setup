[Unit]
Description=Wacom Intuos3 pen setup (mouse / pressure modes, per-app rules)
Documentation=file://%h/.local/bin/wacom-pen-daemon.py
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/wacom-pen-daemon.py
Restart=always
RestartSec=2
Environment=WACOM_DEBUG=0

[Install]
WantedBy=graphical-session.target
